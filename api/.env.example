PORT=4000

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_bengkel
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration (wajib isi dengan string acak yang kuat di production)
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=1d
# ADMIN_ROLES=admin,administrator,superadmin,super admin,owner,adm

# Cookie & CORS Configuration
AUTH_COOKIE_NAME=rejeki_motor_token
# Untuk production HTTPS lintas subdomain/domain, gunakan COOKIE_SAMESITE=none dan COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Pisahkan dengan koma jika lebih dari satu origin frontend
CORS_ORIGIN=http://localhost:8080

# Login Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
